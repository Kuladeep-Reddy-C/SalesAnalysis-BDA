{
  "name": "retail-demand-lab-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --names frontend,backend --prefix-colors cyan,green \"vite\" \"npm run dev:backend\"",
    "dev:backend": "cd .. && if [ ! -f results/metrics/rdd_lab_summary.json ]; then .venv/bin/python run_pipeline.py --rdd-lab; fi && .venv/bin/python -m uvicorn api.main:app --app-dir . --host 127.0.0.1 --port 8000",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.6",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.2.0"
  }
}
